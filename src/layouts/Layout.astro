---
import { lien } from '../lib/url';
import '../styles/global.css';

interface Props { title?: string }
const { title = "Cartable Numérique — Amine" } = Astro.props;
---
<!DOCTYPE html>
<html lang="fr" class="bg-slate-950 text-slate-50 scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
  <meta name="description" content="Cartable numérique d'Amine — 2nde" />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href={lien('favicon.svg')} />
</head>
<body class="min-h-screen flex flex-col"><slot /></body>
</html>
