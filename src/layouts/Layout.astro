---
interface Props { title?: string }
const { title = "Cartable Numérique — Amine" } = Astro.props;
---
<!DOCTYPE html>
<html lang="fr" class="bg-slate-950 text-slate-50 scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
  <meta name="description" content="Cartable numérique d'Amine — 2nde" />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script src="https://cdn.tailwindcss.com?plugins=typography,forms,aspect-ratio,line-clamp"></script>
  <script>tailwind.config = { theme: { extend: { colors: { brand: '#6366f1' }, fontFamily: { sans: ['Inter','system-ui','sans-serif'], serif: ['Georgia','serif'] } } } }</script>
  <style>body{font-family:system-ui,-apple-system,'Segoe UI',sans-serif;-webkit-font-smoothing:antialiased}</style>
</head>
<body class="min-h-screen flex flex-col"><slot /></body>
</html>
