---
import { lien } from '../lib/url';
import Nav from '../components/Nav.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  /** Affiche la coquille de navigation (désactiver sur les écrans plein cadre type connexion). */
  nav?: boolean;
}
const { title = "Cartable Numérique — Amine", nav = true } = Astro.props;
---
<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
  <meta name="description" content="Cartable numérique d'Amine — 2nde" />
  <meta name="theme-color" content="#020617" />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href={lien('favicon.svg')} />
</head>
<body class="min-h-screen flex flex-col bg-slate-950 text-slate-50">
  {nav && <Nav />}
  <div class="flex-1 pb-24 md:pb-0"><slot /></div>
  <script>
    import { proposerReprise } from '../lib/player';

    // ---------- thème clair / sombre ----------
    const appliquerTheme = (clair: boolean) => {
      document.documentElement.classList.toggle('light', clair);
      const b = document.getElementById('themeToggle');
      if (b) b.textContent = clair ? '🌙' : '☀️';
    };
    try {
      const sauve = localStorage.getItem('cartable_theme');
      appliquerTheme(sauve ? sauve === 'light' : window.matchMedia('(prefers-color-scheme: light)').matches);
      document.addEventListener('click', (e) => {
        const t = (e.target as HTMLElement).closest('#themeToggle');
        if (!t) return;
        const clair = !document.documentElement.classList.contains('light');
        appliquerTheme(clair);
        localStorage.setItem('cartable_theme', clair ? 'light' : 'dark');
      });
    } catch { }

    // Sur chaque page : proposer de reprendre la dernière révision audio en cours.
    proposerReprise();
  </script>
</body>
</html>
