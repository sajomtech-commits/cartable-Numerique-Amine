---
import Layout from '../layouts/Layout.astro';
import { lien } from '../lib/url';
import { MATIERES } from '../lib/matieres';
---
<Layout title="Tableau de bord — Cartable Amine">
  <main class="max-w-5xl mx-auto px-5 md:px-8 py-6 md:py-10">

    <!-- ---------- en-tête ---------- -->
    <header class="mb-6 md:mb-8">
      <p id="dateJour" class="text-xs font-semibold uppercase tracking-wider text-brand"></p>
      <h1 class="mt-1 text-3xl md:text-4xl font-extrabold tracking-tight">Bonjour Amine 👋</h1>
      <p class="mt-1 text-sm text-slate-400">2nde · ton cartable numérique</p>
    </header>

    <!-- ---------- bandeau « connecte-toi » (invités) ---------- -->
    <a id="blocInvite" href={lien('/login')} class="hidden mb-6 carte-douce p-4 flex items-center gap-3 hover:ring-brand/40 transition">
      <span class="text-2xl">🔒</span>
      <span class="text-sm">
        <span class="block font-semibold text-white">Connecte-toi</span>
        <span class="block text-slate-400">pour retrouver tes fiches, tes chapitres et tes cours.</span>
      </span>
    </a>

    <!-- ---------- matières ---------- -->
    <section class="mb-6 md:mb-8">
      <h2 class="titre-section mb-3">Mes matières</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
        {MATIERES.map((m) => (
          <a href={lien(`/matieres/${m.slug}`)} data-matiere={m.nom}
             class="carte p-4 hover:-translate-y-0.5 transition-transform">
            <div class="flex items-start justify-between gap-2">
              <span class="text-2xl leading-none">{m.icon}</span>
              <span data-compteur class="pastille bg-slate-800 text-slate-400">0</span>
            </div>
            <p class="mt-3 text-sm font-semibold leading-tight">{m.nom}</p>
            <div class="mt-2 h-1 rounded-full bg-slate-800 overflow-hidden">
              <div data-barre class="h-full w-0 bg-brand rounded-full transition-all duration-500"></div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ---------- chiffres clés ---------- -->
    <section class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4 mb-6 md:mb-8">
      <div class="carte p-4">
        <p class="text-xs font-medium text-slate-500">Fiches</p>
        <p id="statFiches" class="mt-1 text-2xl font-extrabold tabular-nums">–</p>
      </div>
      <div class="carte p-4">
        <p class="text-xs font-medium text-slate-500">Matières actives</p>
        <p id="statMatieres" class="mt-1 text-2xl font-extrabold tabular-nums">–</p>
      </div>
      <div class="carte p-4">
        <p class="text-xs font-medium text-slate-500">Chapitres</p>
        <p id="statChapitres" class="mt-1 text-2xl font-extrabold tabular-nums">–</p>
      </div>
      <div class="carte p-4">
        <p class="text-xs font-medium text-slate-500">Cours rangés</p>
        <p id="statCours" class="mt-1 text-2xl font-extrabold tabular-nums">–</p>
      </div>
    </section>

    <!-- ---------- actions rapides ---------- -->
    <section class="grid sm:grid-cols-2 gap-3 md:gap-4 mb-8">
      <a href={lien('/fiche')} class="carte p-5 flex items-center gap-4 hover:ring-brand/40 transition">
        <span class="grid place-items-center w-12 h-12 rounded-2xl bg-brand text-2xl shadow-lg shrink-0">📷</span>
        <span>
          <span class="block font-bold">Scanner un cours</span>
          <span class="block text-xs text-slate-400">Photo ou PDF → fiche IA</span>
        </span>
      </a>
      <a href={lien('/revisions')} class="carte p-5 flex items-center gap-4 hover:ring-brand/40 transition">
        <span class="grid place-items-center w-12 h-12 rounded-2xl bg-slate-800 text-2xl shrink-0">📚</span>
        <span>
          <span class="block font-bold">Réviser</span>
          <span class="block text-xs text-slate-400">Tes fiches et leurs quiz</span>
        </span>
      </a>
    </section>

    <!-- ---------- dernières fiches ---------- -->
    <section class="mb-8">
      <div class="flex items-center justify-between mb-3">
        <h2 class="titre-section">Dernières fiches</h2>
        <a href={lien('/revisions')} class="text-xs font-semibold text-brand hover:underline">Tout voir →</a>
      </div>
      <div id="recentes" class="space-y-2"></div>
    </section>

  </main>

  <script>
    import { getFiches, type Fiche } from '../lib/fiches';
    import { isLoggedIn } from '../lib/auth';
    import { MATIERES } from '../lib/matieres';
    import { esc } from '../lib/rendu';
    import { lien } from '../lib/url';

    const set = (id: string, v: string | number) => {
      const el = document.getElementById(id);
      if (el) el.textContent = String(v);
    };

    // Date du jour en clair
    const auj = new Date().toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' });
    set('dateJour', auj.charAt(0).toUpperCase() + auj.slice(1));

    const recentes = document.getElementById('recentes')!;

    if (!isLoggedIn()) {
      document.getElementById('blocInvite')?.classList.remove('hidden');
      set('statFiches', '–'); set('statMatieres', '–'); set('statChapitres', '–'); set('statCours', '–');
      recentes.innerHTML = '<p class="carte-douce p-4 text-sm text-slate-400">Connecte-toi pour voir tes fiches récentes.</p>';
    } else {
      const fiches: Fiche[] = await getFiches();

      // --- chiffres clés ---
      const matieresActives = new Set(fiches.map((f) => f.matiere).filter(Boolean));
      const chapitres = new Set(fiches.map((f) => f.chapitreId || f.chapitre).filter(Boolean));
      const coursRanges = fiches.filter((f) => (f.fichiers || []).length > 0).length;
      set('statFiches', fiches.length);
      set('statMatieres', matieresActives.size);
      set('statChapitres', chapitres.size);
      set('statCours', coursRanges);

      // --- dernières fiches ---
      if (!fiches.length) {
        recentes.innerHTML = '<p class="carte-douce p-4 text-sm text-slate-400">Aucune fiche pour l\'instant — <a class="text-brand underline" href="' + lien('/fiche') + '">scanne ton premier cours</a>.</p>';
      } else {
        recentes.innerHTML = fiches.slice(0, 4).map((f) => {
          const m = MATIERES.find((x) => x.nom === f.matiere);
          return '<a href="' + lien('/revisions') + '" class="carte p-4 flex items-center gap-3 hover:ring-brand/40 transition">' +
            '<span class="grid place-items-center w-9 h-9 rounded-xl ' + (m?.couleur || 'bg-slate-700') + ' text-lg shrink-0">' + (m?.icon || '📖') + '</span>' +
            '<span class="min-w-0 flex-1">' +
              '<span class="block font-semibold text-sm truncate">' + esc(f.titre) + '</span>' +
              '<span class="block text-xs text-slate-500 truncate">' + esc(f.matiere) + (f.chapitre ? ' · ' + esc(f.chapitre) : '') + ' · ' + new Date(f.date).toLocaleDateString('fr-FR') + '</span>' +
            '</span>' +
            ((f.fichiers || []).length ? '<span class="text-slate-500 shrink-0" title="Cours PDF conservé">📎</span>' : '') +
          '</a>';
        }).join('');
      }

      // --- compteur + progression par matière ---
      const parMatiere = new Map<string, number>();
      fiches.forEach((f) => parMatiere.set(f.matiere, (parMatiere.get(f.matiere) || 0) + 1));
      const max = Math.max(1, ...parMatiere.values());
      document.querySelectorAll<HTMLElement>('[data-matiere]').forEach((carte) => {
        const n = parMatiere.get(carte.dataset.matiere || '') || 0;
        const c = carte.querySelector<HTMLElement>('[data-compteur]');
        const b = carte.querySelector<HTMLElement>('[data-barre]');
        if (c) { c.textContent = String(n); c.className = 'pastille ' + (n ? 'bg-brand/20 text-brand' : 'bg-slate-800 text-slate-500'); }
        if (b) b.style.width = Math.round((n / max) * 100) + '%';
      });
    }
  </script>
</Layout>
