---
import Layout from '../layouts/Layout.astro';
import { lien } from '../lib/url';
import { MATIERES } from '../lib/matieres';
import { SITE_NOM } from '../lib/site';
---
<Layout title={`Tableau de bord — ${SITE_NOM}`}>
  <main class="max-w-4xl mx-auto px-5 md:px-8 py-8 md:py-12">

    <!-- ---------- en-tête ---------- -->
    <header class="mb-8">
      <p id="dateJour" class="text-xs text-slate-500"></p>
      <div class="flex items-center gap-2 mt-1">
        <h1 class="text-3xl md:text-4xl font-bold tracking-tight">Bonjour <span id="prenom">…</span></h1>
        <span id="badgeClasse" class="pastille bg-slate-800 text-slate-400 mt-1"></span>
      </div>
    </header>

    <!-- ---------- recherche ---------- -->
    <a href={lien('/recherche')}
       class="flex items-center gap-2.5 px-4 py-3 rounded-2xl bg-slate-900/60 ring-1 ring-slate-800 text-sm text-slate-400 hover:ring-brand/50 transition mb-8">
      <span class="text-slate-500">🔎</span> Rechercher un cours, une fiche, un mot…
    </a>

    <!-- ---------- invité ---------- -->
    <a id="blocInvite" href={lien('/login')} class="hidden mb-8 carte-douce p-4 flex items-center gap-3">
      <span class="text-lg">🔒</span>
      <span class="text-sm text-slate-300">Connecte-toi pour retrouver tes fiches et tes cours.</span>
    </a>

    <!-- ---------- actions ---------- -->
    <section class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-10">
      <a href={lien('/fiche')} class="carte p-4 flex flex-col items-start gap-3 hover:ring-brand/50 transition">
        <span class="grid place-items-center w-10 h-10 rounded-xl bg-brand/15 text-lg">📷</span>
        <span>
          <span class="block font-semibold text-sm">Scanner</span>
          <span class="block text-[11px] text-slate-500">un cours</span>
        </span>
      </a>
      <a href={lien('/revisions')} class="carte p-4 flex flex-col items-start gap-3 hover:ring-brand/50 transition">
        <span class="grid place-items-center w-10 h-10 rounded-xl bg-slate-800/70 text-lg">📚</span>
        <span>
          <span class="block font-semibold text-sm">Fiches</span>
          <span class="block text-[11px] text-slate-500">réviser</span>
        </span>
      </a>
      <a href={lien('/quiz')} class="carte p-4 flex flex-col items-start gap-3 hover:ring-brand/50 transition">
        <span class="grid place-items-center w-10 h-10 rounded-xl bg-slate-800/70 text-lg">🎯</span>
        <span>
          <span class="block font-semibold text-sm">Quiz</span>
          <span class="block text-[11px] text-slate-500">s'entraîner</span>
        </span>
      </a>
      <a href={lien('/cours')} class="carte p-4 flex flex-col items-start gap-3 hover:ring-brand/50 transition">
        <span class="grid place-items-center w-10 h-10 rounded-xl bg-slate-800/70 text-lg">📄</span>
        <span>
          <span class="block font-semibold text-sm">Cours</span>
          <span class="block text-[11px] text-slate-500">documents</span>
        </span>
      </a>
    </section>

    <!-- ---------- matières ---------- -->
    <section>
      <div class="flex items-center justify-between mb-3">
        <h2 class="titre-section">Matières</h2>
        <span id="compteMat" class="text-[11px] text-slate-500"></span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3" id="gridMatieres">
        <p class="carte p-4 text-sm text-slate-500 col-span-full">Chargement…</p>
      </div>
      <div class="mt-4 print-hide">
        <button id="btnGereMat" type="button" class="btn-doux !px-3 !py-1.5 !text-xs">⚙️ Gérer mes matières</button>
        <span id="mgMsg" class="text-xs text-slate-500 ml-2"></span>
      </div>
      <div id="panelGereMat" class="hidden carte p-4 mt-3 space-y-3">
        <div class="space-y-2" id="listeGereMat"></div>
        <div class="flex gap-2">
          <input id="mgNom" type="text" placeholder="Nouvelle matière (ex. Arts plastiques)"
                 class="flex-1 min-w-0 bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm" />
          <input id="mgIcone" type="text" placeholder="📖" maxlength="4" value="📖"
                 class="w-14 text-center bg-slate-900 border border-slate-700 rounded-lg px-2 py-2 text-sm" />
          <button id="mgAdd" type="button" class="btn-principal shrink-0 !px-3 !py-1.5 !text-xs">Ajouter</button>
        </div>
      </div>
    </section>
  </main>

  <script>
    import { getFiches, type Fiche } from '../lib/fiches';
    import { getMatieres, ajouterMatiere, supprimerMatiere, type MatiereDyn } from '../lib/matieres';
    import { getProfil } from '../lib/profils';
    import { isLoggedIn } from '../lib/auth';
    import { esc } from '../lib/rendu';
    import { lien } from '../lib/url';

    const set = (id: string, v: string | number) => {
      const el = document.getElementById(id);
      if (el) el.textContent = String(v);
    };

    const auj = new Date().toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' });
    set('dateJour', auj.charAt(0).toUpperCase() + auj.slice(1));

    const grid = document.getElementById('gridMatieres')!;

    /** Reconstruit la grille + le panneau de gestion. */
    async function chargerMatieres(): Promise<MatiereDyn[]> {
      const mats = await getMatieres();
      grid.innerHTML = mats.map((m) =>
        '<a href="' + lien('/matiere') + '?nom=' + encodeURIComponent(m.nom) + '" data-matiere="' + esc(m.nom) + '" class="carte p-4 hover:-translate-y-0.5 transition-transform">' +
          '<div class="flex items-center justify-between mb-2">' +
            '<span class="grid place-items-center w-9 h-9 rounded-xl bg-slate-800/70 text-base">' + esc(m.icone || '📖') + '</span>' +
            '<span data-compteur class="text-[11px] text-slate-500">0</span>' +
          '</div>' +
          '<p class="text-sm font-medium leading-tight">' + esc(m.nom) + '</p>' +
          '<div class="mt-2.5 h-0.5 rounded-full bg-slate-800 overflow-hidden"><div data-barre class="h-full w-0 bg-brand rounded-full transition-all duration-500"></div></div>' +
        '</a>').join('');
      // panneau de gestion
      document.getElementById('listeGereMat')!.innerHTML = mats.map((m) =>
        '<div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-slate-950/60 ring-1 ring-slate-800">' +
          '<span class="text-base">' + esc(m.icone || '📖') + '</span>' +
          '<span class="text-sm font-medium flex-1 truncate">' + esc(m.nom) + '</span>' +
          '<button data-suppr="' + m.id + '" title="Supprimer" class="w-7 h-7 rounded-md bg-slate-800 text-xs text-rose-300 hover:bg-rose-900/60">🗑</button>' +
        '</div>').join('');
      return mats;
    }

    /** Applique les compteurs de fiches par matière. */
    function compteurMatieres(fiches: Fiche[]) {
      const parMatiere = new Map<string, number>();
      fiches.forEach((f) => parMatiere.set(f.matiere, (parMatiere.get(f.matiere) || 0) + 1));
      grid.querySelectorAll<HTMLElement>('[data-matiere]').forEach((carte) => {
        const n = parMatiere.get(carte.dataset.matiere || '') || 0;
        const c = carte.querySelector<HTMLElement>('[data-compteur]');
        const b = carte.querySelector<HTMLElement>('[data-barre]');
        if (c) c.textContent = n ? String(n) : '';
        if (b) b.style.width = Math.min(100, n * 20) + '%';
      });
    }

    if (!isLoggedIn()) {
      document.getElementById('blocInvite')?.classList.remove('hidden');
      grid.innerHTML = '<p class="text-sm text-slate-400 col-span-full">Connecte-toi pour voir tes matières.</p>';
    } else {
      // salutation personnalisée (prenom + classe)
      const profil = await getProfil();
      if (profil) {
        set('prenom', profil.prenom);
        set('badgeClasse', profil.classe || '');
      } else {
        set('prenom', '');
        document.getElementById('badgeClasse')!.textContent = '';
      }
      const mats = await chargerMatieres();
      const fiches: Fiche[] = await getFiches();
      const total = fiches.length;
      set('compteMat', total ? total + ' fiche' + (total > 1 ? 's' : '') : '');
      compteurMatieres(fiches);

      // gestion des matières
      const mgMsg = document.getElementById('mgMsg')!;
      const panel = document.getElementById('panelGereMat')!;
      document.getElementById('btnGereMat')?.addEventListener('click', () => {
        panel.classList.toggle('hidden');
        if (!panel.classList.contains('hidden')) document.getElementById('mgNom')?.focus();
      });
      document.getElementById('listeGereMat')!.addEventListener('click', async (e) => {
        const b = (e.target as HTMLElement).closest('[data-suppr]') as HTMLElement | null;
        if (!b) return;
        if (!confirm('Supprimer cette matière ?')) return;
        if (await supprimerMatiere(b.dataset.suppr!)) {
          mgMsg.textContent = 'Matière supprimée.';
          grid.innerHTML = '<p class="text-sm text-slate-400 col-span-full">Mise à jour…</p>';
          await chargerMatieres();
          compteurMatieres(await getFiches());
        } else mgMsg.textContent = '❌ Suppression impossible.';
      });
      document.getElementById('mgAdd')?.addEventListener('click', async () => {
        const nom = (document.getElementById('mgNom') as HTMLInputElement).value.trim();
        const icone = (document.getElementById('mgIcone') as HTMLInputElement).value.trim() || '📖';
        if (!nom) { mgMsg.textContent = '⚠️ Tape le nom de la matière.'; return; }
        const id = await ajouterMatiere(nom, icone);
        if (!id) { mgMsg.textContent = '❌ Ajout impossible (existe déjà ?).'; return; }
        (document.getElementById('mgNom') as HTMLInputElement).value = '';
        mgMsg.textContent = `✅ « ${nom} » ajoutée.`;
        await chargerMatieres();
        compteurMatieres(await getFiches());
      });
      void mats;
    }
  </script>
</Layout>