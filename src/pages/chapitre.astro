---
import Layout from '../layouts/Layout.astro';
import Barre from '../components/Barre.astro';
import { lien } from '../lib/url';
---
<Layout title="Chapitre — Cartable Amine">
  <main class="max-w-5xl mx-auto px-5 md:px-8 py-6 md:py-10" id="page" data-id="">
    <Barre libelle="Matière" />

    <!-- ---------- en-tête ---------- -->
    <header class="mb-6">
      <a id="lienMatiere" href={lien('/')} class="pastille bg-slate-800 text-slate-400 hover:text-white mb-2">📖 matière</a>
      <div class="flex flex-wrap items-center gap-2">
        <h1 id="titre" class="text-3xl md:text-4xl font-extrabold tracking-tight">Chargement…</h1>
        <button id="renommer" type="button" title="Renommer" class="w-9 h-9 rounded-xl bg-slate-800 hover:bg-slate-700 print-hide">✏️</button>
      </div>
      <p id="resumeChap" class="text-slate-400 text-sm mt-1"></p>
    </header>

    <!-- ---------- chiffres clés ---------- -->
    <section class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4 mb-6">
      <div class="carte p-4"><p class="text-xs font-medium text-slate-500">Cours</p><p id="sCours" class="mt-1 text-2xl font-extrabold tabular-nums">–</p></div>
      <div class="carte p-4"><p class="text-xs font-medium text-slate-500">Fiches</p><p id="sFiches" class="mt-1 text-2xl font-extrabold tabular-nums">–</p></div>
      <div class="carte p-4"><p class="text-xs font-medium text-slate-500">PDF scannés</p><p id="sPdf" class="mt-1 text-2xl font-extrabold tabular-nums">–</p></div>
      <div class="carte p-4"><p class="text-xs font-medium text-slate-500">Questions</p><p id="sQuiz" class="mt-1 text-2xl font-extrabold tabular-nums">–</p></div>
    </section>

    <!-- ---------- actions ---------- -->
    <section class="flex flex-wrap gap-2 mb-6 print-hide">
      <a id="ajouter" href={lien('/fiche')} class="btn-principal">📷 Ajouter un cours</a>
      <button id="exporter" type="button" class="btn-doux">📄 Résumé du chapitre</button>
      <button id="imprimer" type="button" class="btn-doux">🖨️ Imprimer / PDF</button>
      <button id="modeRev" type="button" class="btn-doux">🎯 Mode révision</button>
      <button id="supprimer" type="button" class="btn-doux text-rose-300">🗑 Supprimer le chapitre</button>
    </section>

    <!-- ---------- onglets ---------- -->
    <nav id="onglets" class="flex gap-1 p-1 rounded-2xl bg-slate-900 ring-1 ring-slate-800 mb-5 print-hide">
      <button data-onglet="cours" class="flex-1 rounded-xl px-3 py-2 text-sm font-semibold transition">📖 Cours</button>
      <button data-onglet="fiches" class="flex-1 rounded-xl px-3 py-2 text-sm font-semibold transition">📝 Fiches de révision</button>
      <button data-onglet="pdf" class="flex-1 rounded-xl px-3 py-2 text-sm font-semibold transition">📄 PDF scannés</button>
    </nav>

    <section id="resumeExport" class="hidden mb-6">
      <h2 class="font-bold text-brand mb-2">📄 Fiche de révision complète — ${nom}</h2>
      <div id="resumeExportContent" class="carte p-5"></div>
      <div class="flex gap-2 mt-3 print-hide">
        <button id="printExport" type="button" class="btn-principal text-xs">🖨️ Imprimer / PDF</button>
        <button id="fermerExport" type="button" class="btn-doux text-xs">Fermer</button>
      </div>
    </section>

    <section id="voletCours" class="space-y-3"></section>
    <section id="voletFiches" class="hidden space-y-4"></section>
    <section id="voletPdf" class="hidden space-y-2"></section>
  </main>

  <script>
    import { getChapitre, renommerChapitre, supprimerChapitre } from '../lib/chapitres';
    import { getFiches, updateFiche, type Fiche } from '../lib/fiches';
    import { resumeChapitre } from '../lib/ai';
    import { getControles, enregistrerControle, scoreMoyen, type Controle } from '../lib/controles';
    import { lienCours } from '../lib/storage';
    import { isLoggedIn } from '../lib/auth';
    import { resumeHTML, esc } from '../lib/rendu';
    import { lien } from '../lib/url';

    const page = document.getElementById('page')!;
    const id = new URLSearchParams(location.search).get('id') || '';
    page.dataset.id = id;

    const titreEl = document.getElementById('titre')!;
    const resumeEl = document.getElementById('resumeChap')!;
    const vCours = document.getElementById('voletCours')!;
    const vFiches = document.getElementById('voletFiches')!;
    const vPdf = document.getElementById('voletPdf')!;
    const set = (i: string, v: number | string) => { const e = document.getElementById(i); if (e) e.textContent = String(v); };

    let matiere = '';
    let revision = false;
    let fiches: Fiche[] = [];
    let controles: Controle[] = [];
    /** Dernier quiz passé sur une fiche. */
    const dernierDe = (ficheId: string) => controles.find((c) => c.ficheId === ficheId);

    const vide = (txt: string) => `<p class="carte-douce p-6 text-center text-sm text-slate-400">${txt}</p>`;
    const dateFr = (d: string) => new Date(d).toLocaleDateString('fr-FR');

    /** Affiche l'onglet demandé. */
    function onglet(nom: string) {
      const volets: Record<string, HTMLElement> = { cours: vCours, fiches: vFiches, pdf: vPdf };
      Object.entries(volets).forEach(([k, el]) => el.classList.toggle('hidden', k !== nom));
      document.querySelectorAll('#onglets [data-onglet]').forEach((b) => {
        const actif = (b as HTMLElement).dataset.onglet === nom;
        b.className = `flex-1 rounded-xl px-3 py-2 text-sm font-semibold transition ${actif ? 'bg-brand text-white shadow' : 'text-slate-400 hover:text-white'}`;
      });
    }

    function rendre() {
      const cours = fiches.filter((f) => f.sourceContenu);
      const pdfs = fiches.flatMap((f) => (f.fichiers || []).map((x) => ({ ...x, fiche: f.titre })));
      const questions = fiches.reduce((n, f) => n + f.quiz.length, 0);

      set('sCours', cours.length);
      set('sFiches', fiches.length);
      set('sPdf', pdfs.length);
      set('sQuiz', questions);
      const moy = scoreMoyen(controles);
      resumeEl.textContent = `${fiches.length} fiche${fiches.length > 1 ? 's' : ''}${pdfs.length ? ' · ' + pdfs.length + ' PDF' : ''}${questions ? ' · ' + questions + ' questions' : ''}${moy !== null ? ' · moyenne ' + moy + '%' : ''}`;

      // --- Cours ---
      vCours.innerHTML = cours.length
        ? cours.map((f) => `
            <details class="carte overflow-hidden" ${cours.length === 1 ? 'open' : ''}>
              <summary class="px-4 py-3 text-sm font-semibold cursor-pointer">📖 ${esc(f.titre)} <span class="text-xs text-slate-500 font-normal">· ${dateFr(f.date)}</span></summary>
              <div class="px-4 pb-4 text-sm text-slate-300 leading-relaxed max-h-[28rem] overflow-auto">${resumeHTML(f.sourceContenu)}</div>
            </details>`).join('')
        : vide('Aucun cours pour ce chapitre. Clique sur « 📷 Ajouter un cours ».');

      // --- Fiches ---
      vFiches.innerHTML = fiches.length
        ? fiches.map((f) => `
            <details class="carte overflow-hidden" data-fiche="${f.id}">
              <summary class="px-4 py-3 font-bold text-sm cursor-pointer">
                ${esc(f.titre)} <span class="text-xs text-slate-500 font-normal">· ${dateFr(f.date)}</span>
                <button data-edit="${f.id}" type="button" class="ml-2 text-[10px] text-slate-500 hover:text-brand print-hide" onclick="event.stopPropagation()">✏️ Modifier</button>
              </summary>
              <div class="px-4 pb-4">
                <div data-resume class="${revision ? 'hidden' : ''}">${resumeHTML(f.resume)}</div>
                ${f.traduction ? `<details class="mt-3 rounded-xl bg-slate-950 ring-1 ring-slate-800"><summary class="px-3 py-2 text-xs font-semibold text-brand cursor-pointer">🇫🇷 Traduction du cours</summary><div class="px-3 pb-3">${resumeHTML(f.traduction)}</div></details>` : ''}
                ${(f.vocabulaire || []).length ? `<details class="mt-2 rounded-xl bg-slate-950 ring-1 ring-slate-800"><summary class="px-3 py-2 text-xs font-semibold text-brand cursor-pointer">📖 Vocabulaire (${f.vocabulaire.length})</summary><div class="px-3 pb-3 grid sm:grid-cols-2 gap-1.5 text-xs">${f.vocabulaire.map((v) => `<div><b class="text-white">${esc(v.mot)}</b> <span class="text-slate-500">→</span> <span class="text-emerald-300">${esc(v.fr)}</span></div>`).join('')}</div></details>` : ''}
                ${f.pointsCles.length ? `<div data-resume class="${revision ? 'hidden' : ''}"><p class="text-xs font-bold text-brand mt-4 mb-1">Points clés</p><ul class="space-y-1.5 text-sm text-slate-200">${f.pointsCles.map((p) => `<li class="leading-relaxed pl-4 relative"><span class="absolute left-0 text-brand">•</span>${esc(p)}</li>`).join('')}</ul></div>` : ''}
                ${f.quiz.length ? `<p class="text-xs font-bold text-brand mt-4 mb-2">Quiz</p><div class="space-y-2">${f.quiz.map((q) => `<details class="bg-slate-950 rounded-xl p-3"><summary class="text-sm font-medium cursor-pointer">${esc(q.q)}</summary><p class="text-sm text-emerald-300 mt-2">${esc(q.r)}</p></details>`).join('')}</div>` : ''}
                ${f.quiz.length ? `<div class="mt-3 flex flex-wrap items-center gap-2 print-hide">
                  <button data-quiz="${f.id}" class="btn-principal text-xs">🎯 Faire le quiz</button>
                  ${dernierDe(f.id) ? `<span class="pastille bg-slate-800 text-slate-300">Dernier : ${dernierDe(f.id)!.score}/${dernierDe(f.id)!.total}</span>` : '<span class="text-[11px] text-slate-500">jamais fait</span>'}
                </div>` : ''}
                <div data-quizzone="${f.id}" class="hidden mt-3"></div>
                <div data-editzone="${f.id}" class="hidden mt-3 bg-slate-950 rounded-xl p-3 ring-1 ring-slate-800">
                  <label class="block text-xs font-bold text-slate-500 mb-1">Titre</label>
                  <input data-etitre="${f.id}" value="${esc(f.titre)}" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-sm mb-2" />
                  <label class="block text-xs font-bold text-slate-500 mb-1">Résumé</label>
                  <textarea data-eresume="${f.id}" rows="8" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm mb-2 font-mono text-xs leading-relaxed">${esc(f.resume)}</textarea>
                  <div class="flex items-center gap-2">
                    <button data-esave="${f.id}" class="btn-principal text-xs">💾 Enregistrer</button>
                    <button data-ecancel="${f.id}" class="btn-doux text-xs">Annuler</button>
                    <span data-emsg="${f.id}" class="text-xs text-slate-500"></span>
                  </div>
                </div>
              </div>
            </details>`).join('')
        : vide('Aucune fiche de révision. Ajoute un cours, l\'IA la génère.');

      // --- PDF ---
      vPdf.innerHTML = pdfs.length
        ? pdfs.map((x) => `<a data-path="${esc(x.path)}" href="#"
             class="carte p-4 flex items-center gap-3 hover:ring-brand/40 transition">
             <span class="grid place-items-center w-10 h-10 rounded-xl bg-slate-800 text-lg shrink-0">${x.type === 'photo' ? '🖼️' : '📄'}</span>
             <span class="min-w-0 flex-1">
               <span class="block text-sm font-semibold truncate">${esc(x.nom)}</span>
               <span class="block text-[11px] text-slate-500 truncate">${esc(x.fiche)} · ${Math.round((x.taille || 0) / 1024)} Ko</span>
             </span>
             <span class="text-slate-500 shrink-0">↗</span>
           </a>`).join('')
        : vide('Aucun PDF conservé pour ce chapitre.');

      vPdf.querySelectorAll('[data-path]').forEach((a) => {
        lienCours((a as HTMLElement).dataset.path!, 3600, true).then((u) => {
          if (u) { (a as HTMLAnchorElement).href = u; (a as HTMLAnchorElement).target = '_blank'; (a as HTMLAnchorElement).rel = 'noopener'; }
        });
      });

      // Quiz noté : auto-évaluation question par question
      vFiches.querySelectorAll('[data-quiz]').forEach((b) => b.addEventListener('click', () => {
        const fid = (b as HTMLElement).dataset.quiz!;
        const f = fiches.find((x) => x.id === fid);
        const z = vFiches.querySelector(`[data-quizzone="${fid}"]`) as HTMLElement | null;
        if (!f || !z) return;
        z.classList.remove('hidden');
        z.scrollIntoView({ behavior: 'smooth', block: 'center' });
        quizInteractif(f, z);
      }));
    }

    /** Quiz en auto-évaluation : on affiche la réponse, l'élève dit s'il avait bon. */
    function quizInteractif(f: Fiche, zone: HTMLElement) {
      const n = f.quiz.length;
      if (!n) return;
      const reponses: (boolean | null)[] = f.quiz.map(() => null);
      let i = 0;
      let montre = false;

      const dessiner = () => {
        // --- fin : score + enregistrement ---
        if (i >= n) {
          const score = reponses.filter(Boolean).length;
          const pct = Math.round((score / n) * 100);
          const couleur = pct >= 70 ? 'text-emerald-400' : pct >= 40 ? 'text-amber-400' : 'text-rose-400';
          zone.innerHTML = `
            <div class="carte p-5 text-center">
              <p class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Résultat</p>
              <p class="text-4xl font-extrabold mt-1 ${couleur}">${score}/${n}</p>
              <p class="text-sm text-slate-400 mt-1">${pct >= 70 ? 'Bravo ! 🎉' : pct >= 40 ? 'Pas mal — à revoir 👍' : 'À retravailler 💪'}</p>
              <p id="qSaved" class="text-xs text-slate-500 mt-2">💾 Enregistrement…</p>
              <button data-recommencer class="btn-doux text-xs mt-3">🔁 Recommencer</button>
            </div>`;
          zone.querySelector('[data-recommencer]')?.addEventListener('click', () => {
            i = 0; montre = false; reponses.fill(null); dessiner();
          });
          enregistrerControle(f.id, score, n, f.quiz.map((q, k) => ({ q: q.q, juste: !!reponses[k] })))
            .then((ok) => { const e = document.getElementById('qSaved'); if (e) e.textContent = ok ? '✅ Résultat enregistré.' : '⚠️ Résultat non enregistré.'; });
          return;
        }
        // --- question courante ---
        const q = f.quiz[i];
        const puces = f.quiz.map((_, k) =>
          `<span class="w-2 h-2 rounded-full ${reponses[k] === true ? 'bg-emerald-400' : reponses[k] === false ? 'bg-rose-400' : k === i ? 'bg-brand' : 'bg-slate-700'}"></span>`).join('');
        zone.innerHTML = `
          <div class="carte p-4">
            <div class="flex items-center justify-between mb-2">
              <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Question ${i + 1}/${n}</span>
              <div class="flex gap-0.5">${puces}</div>
            </div>
            <p class="font-semibold text-sm">${esc(q.q)}</p>
            ${montre
              ? `<p class="mt-3 text-sm text-emerald-300 bg-slate-950 rounded-xl p-3">${esc(q.r)}</p>
                 <div class="flex gap-2 mt-3">
                   <button data-bon class="btn-doux flex-1 text-xs">✅ J'avais bon</button>
                   <button data-rate class="btn-doux flex-1 text-xs">❌ Raté</button>
                 </div>`
              : `<button data-voir class="btn-doux text-xs mt-3">👁️ Voir la réponse</button>`}
          </div>`;
        zone.querySelector('[data-voir]')?.addEventListener('click', () => { montre = true; dessiner(); });
        const suivant = (ok: boolean) => { reponses[i] = ok; i++; montre = false; dessiner(); };
        zone.querySelector('[data-bon]')?.addEventListener('click', () => suivant(true));
        zone.querySelector('[data-rate]')?.addEventListener('click', () => suivant(false));
      };
      dessiner();
    }

    async function charger() {
      const chap = await getChapitre(id);
      if (!chap) {
        titreEl.textContent = 'Chapitre introuvable';
        resumeEl.textContent = 'Il a peut-être été supprimé.';
        [vCours, vFiches, vPdf].forEach((v) => (v.innerHTML = ''));
        return;
      }
      matiere = chap.matiere || '';
      titreEl.textContent = chap.titre;
      document.title = chap.titre + ' — Cartable Amine';
      const a = document.getElementById('lienMatiere') as HTMLAnchorElement;
      a.textContent = '📖 ' + (matiere || 'matière');
      a.href = lien('/matieres/' + (matiere || '').toLowerCase());
      (document.getElementById('ajouter') as HTMLAnchorElement).href =
        `${lien('/fiche')}?matiere=${encodeURIComponent(matiere)}&chapitre=${encodeURIComponent(chap.titre)}`;

      fiches = (await getFiches()).filter((f) => f.chapitreId === chap.id);
      const ids = new Set(fiches.map((f) => f.id));
      controles = (await getControles()).filter((c) => c.ficheId && ids.has(c.ficheId));
      rendre();
    }

    // Actions
    document.getElementById('renommer')?.addEventListener('click', async () => {
      const nouveau = prompt('Nouveau nom du chapitre :', titreEl.textContent || '');
      if (nouveau === null || !nouveau.trim() || nouveau.trim() === titreEl.textContent) return;
      if (await renommerChapitre(id, nouveau)) { titreEl.textContent = nouveau.trim(); document.title = nouveau.trim(); }
      else alert('❌ Renommage impossible.');
    });

    document.getElementById('supprimer')?.addEventListener('click', async () => {
      if (!confirm('Supprimer ce chapitre ? Les fiches liées seront conservées (sans chapitre).')) return;
      if (await supprimerChapitre(id)) { location.href = lien('/'); }
      else alert('❌ Suppression impossible.');
    });

    document.getElementById('imprimer')?.addEventListener('click', () => window.print());

    const modeRev = document.getElementById('modeRev') as HTMLButtonElement;
    modeRev?.addEventListener('click', () => {
      revision = !revision;
      document.querySelectorAll('[data-resume]').forEach((e) => e.classList.toggle('hidden', revision));
      modeRev.textContent = revision ? '📖 Afficher le cours' : '🎯 Mode révision';
    });

    document.querySelectorAll('#onglets [data-onglet]').forEach((b) =>
      b.addEventListener('click', () => onglet((b as HTMLElement).dataset.onglet!)));

    // Édition de fiche
    vFiches.addEventListener('click', async (e) => {
      const tgt = e.target as HTMLElement;
      // Ouvrir l'éditeur
      if (tgt.dataset.edit) {
        e.stopPropagation();
        const fid = tgt.dataset.edit;
        const zone = vFiches.querySelector(`[data-editzone="${fid}"]`) as HTMLElement;
        if (zone) { zone.classList.toggle('hidden'); zone.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); }
        return;
      }
      // Annuler
      if (tgt.dataset.ecancel) {
        e.stopPropagation();
        const fid = tgt.dataset.ecancel;
        vFiches.querySelector(`[data-editzone="${fid}"]`)?.classList.add('hidden');
        return;
      }
      // Enregistrer
      if (tgt.dataset.esave) {
        e.stopPropagation();
        const fid = tgt.dataset.esave;
        const titreIn = vFiches.querySelector(`[data-etitre="${fid}"]`) as HTMLInputElement;
        const resumeIn = vFiches.querySelector(`[data-eresume="${fid}"]`) as HTMLTextAreaElement;
        const msgEl = vFiches.querySelector(`[data-emsg="${fid}"]`)!;
        if (!titreIn || !resumeIn) return;
        msgEl.textContent = '💾 Enregistrement…';
        const ok = await updateFiche(fid, { titre: titreIn.value, resume: resumeIn.value });
        if (ok) {
          msgEl.textContent = '✅ Enregistré.';
          // Met à jour l'affichage
          const f = fiches.find((x) => x.id === fid);
          if (f) { f.titre = titreIn.value; f.resume = resumeIn.value; }
          const card = vFiches.querySelector(`details[data-fiche="${fid}"]`);
          if (card) { card.querySelector('summary')!.innerHTML = `${esc(titreIn.value)} <span class="text-xs text-slate-500 font-normal">· modifié</span> <button data-edit="${fid}" type="button" class="ml-2 text-[10px] text-slate-500 hover:text-brand print-hide" onclick="event.stopPropagation()">✏️ Modifier</button>`; }
          setTimeout(() => { vFiches.querySelector(`[data-editzone="${fid}"]`)?.classList.add('hidden'); msgEl.textContent = ''; }, 1200);
        } else {
          msgEl.textContent = '❌ Échec.';
        }
      }
    });

    // Export : résumé complet du chapitre par l'IA
    document.getElementById('exporter')?.addEventListener('click', async () => {
      if (!fiches.length) { alert('Aucune fiche dans ce chapitre.'); return; }
      const section = document.getElementById('resumeExport')!;
      const content = document.getElementById('resumeExportContent')!;
      section.classList.remove('hidden');
      content.innerHTML = '<p class="text-sm text-slate-400">⏳ L\'IA synthétise toutes les fiches du chapitre… (~30 s)</p>';
      section.scrollIntoView({ behavior: 'smooth', block: 'start' });
      try {
        const coursTextes = fiches.filter((f) => f.sourceContenu).map((f) => f.sourceContenu);
        const ficheTextes = fiches.map((f) => `Titre : ${f.titre}\nRésumé : ${f.resume}\nPoints clés : ${f.pointsCles.join(', ')}`);
        const synthese = await resumeChapitre(matiere, titreEl.textContent || '', coursTextes, ficheTextes);
        content.innerHTML = `<h3 class="font-bold text-lg mb-2">${esc(synthese.titre)}</h3><div>${resumeHTML(synthese.resume)}</div>` +
          (synthese.pointsCles.length ? `<h4 class="font-bold text-brand mt-4 mb-1">Points clés</h4><ul class="space-y-1 text-sm">${synthese.pointsCles.map((p) => `<li class="pl-4 relative"><span class="absolute left-0 text-brand">•</span>${esc(p)}</li>`).join('')}</ul>` : '') +
          (synthese.quiz.length ? `<h4 class="font-bold text-brand mt-4 mb-2">Quiz</h4><div class="space-y-2">${synthese.quiz.map((q) => `<details class="bg-slate-950 rounded-xl p-3"><summary class="text-sm font-medium cursor-pointer">${esc(q.q)}</summary><p class="text-sm text-emerald-300 mt-2">${esc(q.r)}</p></details>`).join('')}</div>` : '');
      } catch (err: any) {
        content.innerHTML = `<p class="text-sm text-rose-400">❌ ${esc(err.message)}</p>`;
      }
    });

    document.getElementById('printExport')?.addEventListener('click', () => window.print());
    document.getElementById('fermerExport')?.addEventListener('click', () => document.getElementById('resumeExport')?.classList.add('hidden'));

    if (!isLoggedIn()) window.location.href = lien('/login');
    else { onglet('cours'); charger(); }
  </script>
</Layout>
