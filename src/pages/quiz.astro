---
import Layout from '../layouts/Layout.astro';
import Barre from '../components/Barre.astro';
import { lien } from '../lib/url';
import { MATIERES } from '../lib/matieres';
import { SITE_NOM } from '../lib/site';
---
<Layout title={`Quiz — ${SITE_NOM}`}>
  <main class="max-w-3xl mx-auto px-5 md:px-8 py-6 md:py-10">
    <Barre libelle="Accueil" />

    <header class="mb-6">
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight">🎯 Quiz mixte</h1>
      <p class="text-slate-400 text-sm mt-1">Mélange de toutes les fiches d'une matière — simulation de contrôle.</p>
    </header>

    <section id="selector" class="carte p-5 mb-6">
      <label class="block mb-2 text-sm font-semibold">Choisis la matière</label>
      <div class="flex flex-wrap gap-2" id="listeMatieres">
        <p class="text-xs text-slate-500">Chargement…</p>
      </div>
      <p id="selMsg" class="text-xs text-slate-500 mt-3"></p>
    </section>

    <div id="quizZone" class="hidden"></div>
    <div id="resultat" class="hidden"></div>
  </main>

  <script>
    import { getFiches, type Fiche } from '../lib/fiches';
    import { enregistrerControle } from '../lib/controles';
    import { isLoggedIn } from '../lib/auth';
    import { getMatieres } from '../lib/matieres';
    import { esc } from '../lib/rendu';
    import { lien } from '../lib/url';

    const zone = document.getElementById('quizZone')!;
    const resEl = document.getElementById('resultat')!;
    const selMsg = document.getElementById('selMsg')!;

    interface Question { q: string; r: string; ficheTitre: string; }

    /** Mélange un tableau (Fisher-Yates). */
    function shuffle<T>(arr: T[]): T[] {
      const a = [...arr];
      for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; }
      return a;
    }

    let toutes: Fiche[] = [];
    if (!isLoggedIn()) {
      selMsg.innerHTML = `🔒 <a class="text-brand hover:underline" href="${lien('/login')}">Connecte-toi</a> pour faire un quiz.`;
    } else {
      toutes = await getFiches();
      // Matières du compte (auto-initialisées si vide)
      const mats = await getMatieres();
      const sel = document.getElementById('listeMatieres')!;
      sel.innerHTML = mats.map((m) =>
        '<button data-mat="' + esc(m.nom) + '" class="btn-doux text-xs"><span class="mr-1">' + esc(m.icone || '📖') + '</span>' + esc(m.nom) + '</button>').join('');
    }

    document.querySelectorAll('[data-mat]').forEach((b) => b.addEventListener('click', () => {
      const mat = (b as HTMLElement).dataset.mat!;
      const fs = toutes.filter((f) => f.matiere === mat);
      const allQ: Question[] = fs.flatMap((f) => f.quiz.map((q) => ({ q: q.q, r: q.r, ficheTitre: f.titre })));
      if (!allQ.length) { selMsg.textContent = `Aucune question pour ${mat}. Ajoute des fiches d'abord.`; return; }
      selMsg.textContent = '';
      demarrerQuiz(mat, shuffle(allQ));
    }));

    function demarrerQuiz(matiere: string, questions: Question[]) {
      document.getElementById('selector')!.classList.add('hidden');
      resEl.classList.add('hidden');
      zone.classList.remove('hidden');
      const n = questions.length;
      const reponses: (boolean | null)[] = questions.map(() => null);
      let i = 0;
      let montre = false;

      const dessiner = () => {
        if (i >= n) {
          const score = reponses.filter(Boolean).length;
          const pct = Math.round((score / n) * 100);
          const couleur = pct >= 70 ? 'text-emerald-400' : pct >= 40 ? 'text-amber-400' : 'text-rose-400';
          zone.innerHTML = `<div class="carte p-6 text-center">
            <p class="text-4xl font-extrabold ${couleur}">${score}/${n}</p>
            <p class="text-sm text-slate-400 mt-1">${pct >= 70 ? 'Bravo ! 🎉' : pct >= 40 ? 'Pas mal, continue ! 👍' : 'Courage, révise encore 💪'}</p>
            <p class="text-xs text-slate-500 mt-2">${matiere} · ${n} questions</p>
            <p id="qSaved" class="text-xs text-slate-500 mt-1">💾 Enregistrement…</p>
            <div class="flex justify-center gap-2 mt-4">
              <button data-recommencer class="btn-doux text-xs">🔁 Recommencer</button>
              <button data-retour class="btn-doux text-xs">📚 Changer de matière</button>
            </div>
          </div>`;
          zone.querySelector('[data-recommencer]')?.addEventListener('click', () => { i = 0; montre = false; reponses.fill(null); dessiner(); });
          zone.querySelector('[data-retour]')?.addEventListener('click', () => { zone.classList.add('hidden'); document.getElementById('selector')!.classList.remove('hidden'); });
          enregistrerControle(null, score, n, questions.map((q, k) => ({ q: q.q, juste: !!reponses[k] })))
            .then((ok) => { const e = document.getElementById('qSaved'); if (e) e.textContent = ok ? '✅ Résultat enregistré.' : ''; });
          return;
        }
        const q = questions[i];
        const puces = questions.map((_, k) =>
          `<span class="w-2 h-2 rounded-full ${reponses[k] === true ? 'bg-emerald-400' : reponses[k] === false ? 'bg-rose-400' : k === i ? 'bg-brand' : 'bg-slate-700'}"></span>`).join('');
        zone.innerHTML = `<div class="carte p-5">
          <div class="flex items-center justify-between mb-3">
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Question ${i + 1}/${n}</span>
            <div class="flex gap-0.5">${puces}</div>
          </div>
          <p class="font-semibold text-sm mb-1">${esc(q.q)}</p>
          <p class="text-[11px] text-slate-500 italic mb-3">📍 ${esc(q.ficheTitre)}</p>
          ${montre
            ? `<p class="text-sm text-emerald-300 bg-slate-950 rounded-xl p-3">${esc(q.r)}</p>
               <div class="flex gap-2 mt-3">
                 <button data-bon class="btn-doux flex-1 text-xs">✅ J'avais bon</button>
                 <button data-rate class="btn-doux flex-1 text-xs">❌ Raté</button>
               </div>`
            : `<button data-voir class="btn-doux text-xs">👁️ Voir la réponse</button>`}
        </div>`;
        zone.querySelector('[data-voir]')?.addEventListener('click', () => { montre = true; dessiner(); });
        zone.querySelector('[data-bon]')?.addEventListener('click', () => { reponses[i] = true; i++; montre = false; dessiner(); });
        zone.querySelector('[data-rate]')?.addEventListener('click', () => { reponses[i] = false; i++; montre = false; dessiner(); });
      };
      dessiner();
    }
  </script>
</Layout>
