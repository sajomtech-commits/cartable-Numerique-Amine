---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Upload PDF — Amine">
  <main class="max-w-xl mx-auto px-5 py-8">
    <h1 class="text-2xl font-extrabold mb-2">Téléverser un cours</h1>
    <p class="text-slate-400 mb-6">PDF → texte (PDF.js) → résumé IA (HuggingFace)</p>

    <label class="block bg-brand/10 border-2 border-brand/30 border-dashed rounded-2xl p-10 text-center cursor-pointer hover:bg-brand/20 transition mb-4">
      <span class="text-4xl">📄</span>
      <span class="block mt-2 font-semibold">Cliquez pour choisir un PDF</span>
      <input id="file" type="file" accept=".pdf" class="hidden" />
    </label>

    <div class="mb-2"><label>Matière</label><select id="matiere" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm"><option>SVT</option><option>Maths</option><option>Français</option><option>Physique-Chimie</option><option>Anglais</option><option>Espagnol</option></select></div>

    <label>Clé DeepSeek (si pas dans localStorage)</label>
    <input id="hfk" type="password" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm mb-4" placeholder="sk-..." />

    <button onclick="process()" class="w-full bg-brand hover:bg-indigo-600 text-white font-bold py-3 rounded-xl shadow-lg transition">Résumer avec l'IA</button>

    <div id="status" class="mt-4 text-sm text-slate-300 min-h-[3rem]"></div>
    <pre id="res" class="bg-slate-900 rounded-xl p-4 text-xs overflow-auto mt-2 font-mono text-emerald-200 hidden"></pre>
  </main>

  <script type="module">
    import * as pdfjsLib from 'pdfjs-dist';
    import workerUrl from 'pdfjs-dist/build/pdf.worker.min.mjs?url';
    pdfjsLib.GlobalWorkerOptions.workerSrc = workerUrl;
    window.process = async () => {
      const file = document.getElementById('file').files[0];
      const mat = document.getElementById('matiere').value;
      const hf = document.getElementById('hfk').value || localStorage.getItem('deepseek_key') || '';
      if (hf) localStorage.setItem('deepseek_key', hf);
      const st = document.getElementById('status');
      if (!file) { st.textContent = 'Choisissez un PDF'; return; }
      st.textContent = 'Lecture PDF...';
      const typed = await file.arrayBuffer();
      const pdf = await pdfjsLib.getDocument({ data: typed }).promise;
      let txt = '';
      for (let i = 1; i <= Math.min(pdf.numPages, 10); i++) {
        const page = await pdf.getPage(i);
        const tc = await page.getTextContent();
        txt += tc.items.map((it: any) => it.str).join(' ') + '\n';
      }
      st.textContent = 'Envoi IA...';
      try {
        const r = await fetch('https://api.deepseek.com/chat/completions', {
          method: 'POST', headers: { Authorization: `Bearer ${hf}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({
            model: 'deepseek-chat',
            messages: [
              { role: 'system', content: 'Tu es un assistant pédagogique pour un lycéen français.' },
              { role: 'user', content: `Résume ce chapitre de ${mat} en 10 points max, en markdown :\n\n${txt.slice(0, 6000)}` }
            ],
            max_tokens: 800, temperature: 0.3
          })
        });
        const j = await r.json();
        if (!r.ok) throw new Error(JSON.stringify(j));
        const out = j.choices?.[0]?.message?.content || JSON.stringify(j);
        document.getElementById('res').classList.remove('hidden');
        document.getElementById('res').textContent = out;
        st.textContent = `Résumé OK (${txt.length} caractères extraits)`;
      } catch (e: any) { st.textContent = 'Erreur IA: ' + e.message; }
    };
  </script>
</Layout>
