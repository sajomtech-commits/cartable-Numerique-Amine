---
import Layout from '../layouts/Layout.astro';
import Barre from '../components/Barre.astro';
import { lien } from '../lib/url';
---
<Layout title="Matière — Cartable">
  <main class="max-w-5xl mx-auto px-5 md:px-8 py-6 md:py-10" data-matiere="">
    <Barre libelle="Accueil" />

    <header class="mb-6">
      <h1 id="titreMat" class="text-3xl md:text-4xl font-extrabold tracking-tight"></h1>
      <p id="resumeMat" class="text-slate-400 text-sm mt-1">Tes chapitres, tes cours et tes fiches.</p>
      <a id="lienAjouter" href={lien('/fiche')}
         class="inline-block mt-2 text-xs text-slate-500 hover:text-brand transition">📷 Ajouter un cours scanné</a>
    </header>

    <!-- créer un chapitre -->
    <section class="carte p-4 mb-6">
      <div class="flex gap-2">
        <input id="chapNom" type="text" placeholder="Nouveau chapitre (ex. Chapitre 3 — Les vecteurs)"
               class="flex-1 min-w-0 bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-sm" />
        <button id="chapAdd" type="button" class="btn-principal shrink-0">➕ Créer</button>
      </div>
      <p id="chapMsg" class="text-xs text-slate-500 mt-2"></p>
    </section>

    <div id="liste" class="space-y-3"></div>
  </main>

  <script>
    import { getFiches, type Fiche } from '../lib/fiches';
    import { getChapitres, creerChapitre, renommerChapitre, supprimerChapitre, reordonnerChapitres } from '../lib/chapitres';
    import type { Chapitre } from '../lib/chapitres';
    import { lienCours } from '../lib/storage';
    import { isLoggedIn } from '../lib/auth';
    import { demanderTexte } from '../lib/demandeur';
    import { resumeHTML, esc } from '../lib/rendu';
    import { lien } from '../lib/url';
    import { iconePour } from '../lib/matieres';
    import { SITE_NOM } from '../lib/site';

    // Matière lue dans l'URL : /matiere/?nom=Maths
    const params = new URLSearchParams(location.search);
    const nomMat = (params.get('nom') || '').trim();
    const main = document.querySelector('main')!;
    main.setAttribute('data-matiere', nomMat);
    if (!nomMat) {
      document.getElementById('titreMat')!.textContent = 'Matière introuvable';
      document.getElementById('liste')!.innerHTML = '<p class="carte-douce p-6 text-center text-sm text-slate-400">Aucune matière indiquée.</p>';
      throw new Error('stop');
    }
    document.getElementById('titreMat')!.textContent = iconePour(nomMat) + ' ' + nomMat;
    document.title = nomMat + ' — ' + SITE_NOM;
    (document.getElementById('lienAjouter') as HTMLAnchorElement).href =
      lien('/fiche') + '?matiere=' + encodeURIComponent(nomMat);

    const nomMatiere = nomMat;
    const liste = document.getElementById('liste')!;
    const chapMsg = document.getElementById('chapMsg')!;
    const chapNom = document.getElementById('chapNom') as HTMLInputElement;

    let chapitres: Chapitre[] = [];
    let fiches: Fiche[] = [];

    const dateFr = (d: string) => new Date(d).toLocaleDateString('fr-FR');

    function carteChapitre(c: Chapitre | null, fs: Fiche[], index: number) {
      const id = c?.id ?? 'sans';
      const titre = c ? esc(c.titre) : 'Sans chapitre';
      const nbPdf = fs.reduce((n, f) => n + (f.fichiers || []).length, 0);
      const bouton = (attr: string, icone: string, titreBtn: string, extra = '') =>
        `<button ${attr} title="${titreBtn}" class="grid place-items-center w-7 h-7 rounded-md bg-slate-800/80 hover:bg-slate-700 text-[13px] leading-none ${extra}">${icone}</button>`;
      const edition = c
        ? `<div class="flex items-center gap-0.5 shrink-0">
             ${bouton('data-up', '↑', 'Monter', index === 0 ? 'opacity-25' : '')}
             ${bouton('data-down', '↓', 'Descendre', index === chapitres.length - 1 ? 'opacity-25' : '')}
             ${bouton('data-ren', '✏️', 'Renommer')}
             ${bouton('data-del', '🗑', 'Supprimer', 'text-rose-300 hover:!bg-rose-900/60')}
           </div>`
        : '';
      if (!c) {
        return `<article class="carte px-4 py-3 flex items-center gap-3" data-chap="sans">
          <span class="font-semibold text-sm text-slate-400 truncate">${titre}</span>
          <span class="ml-auto text-[11px] text-slate-500 shrink-0">${fs.length} fiche(s)</span>
        </article>`;
      }
      return `<article class="carte overflow-hidden" data-chap="${id}">
        <div class="flex items-center gap-2 px-4 py-2.5 border-b border-slate-800/70">
          <span class="pastille bg-brand/15 text-brand shrink-0">n° ${c.numero ?? '?'}</span>
          <a href="${lien('/chapitre')}?id=${c.id}" class="font-semibold text-sm truncate flex-1 min-w-0 hover:text-brand transition">${titre}</a>
          <span class="text-[11px] text-slate-500 shrink-0">${fs.length} fiche${fs.length > 1 ? 's' : ''}${nbPdf ? ' · ' + nbPdf + ' PDF' : ''}</span>
        </div>
        <div class="flex items-center gap-2 px-4 py-2">
          <a href="${lien('/chapitre')}?id=${c.id}" class="btn-principal !px-3 !py-1 !text-xs">Ouvrir</a>
          <a href="${lien('/fiche')}?matiere=${encodeURIComponent(c.matiere || '')}&chapitre=${encodeURIComponent(c.titre)}" class="btn-doux !px-3 !py-1 !text-xs">📷 Cours</a>
          <div class="ml-auto">${edition}</div>
        </div>
      </article>`;
    }

    function rendre() {
      const parChap = new Map<string, Fiche[]>();
      fiches.forEach((f) => {
        const k = f.chapitreId || 'sans';
        parChap.set(k, [...(parChap.get(k) || []), f]);
      });
      const orphelines = parChap.get('sans') || [];
      const totalPdf = fiches.reduce((n, f) => n + (f.fichiers || []).length, 0);
      document.getElementById('resumeMat')!.textContent =
        `${chapitres.length} chapitre${chapitres.length > 1 ? 's' : ''} · ${fiches.length} fiche${fiches.length > 1 ? 's' : ''}${totalPdf ? ' · ' + totalPdf + ' PDF' : ''}`;

      liste.innerHTML = chapitres.length || orphelines.length
        ? chapitres.map((c, i) => carteChapitre(c, parChap.get(c.id) || [], i)).join('') +
          (orphelines.length ? carteChapitre(null, orphelines, -1) : '')
        : '<p class="carte-douce p-6 text-center text-sm text-slate-400">Aucun chapitre pour l\'instant.<br />Crée ton premier chapitre ci-dessus, puis ajoute un cours scanné.</p>';

      liste.querySelectorAll('article[data-chap]').forEach((art) => {
        const id = art.getAttribute('data-chap')!;
        if (id === 'sans') return;
        const idx = chapitres.findIndex((c) => c.id === id);
        art.querySelector('[data-up]')?.addEventListener('click', async () => {
          if (idx <= 0) return;
          const ids = chapitres.map((c) => c.id);
          [ids[idx - 1], ids[idx]] = [ids[idx], ids[idx - 1]];
          if (await reordonnerChapitres(ids)) { await charger(); }
        });
        art.querySelector('[data-down]')?.addEventListener('click', async () => {
          if (idx < 0 || idx >= chapitres.length - 1) return;
          const ids = chapitres.map((c) => c.id);
          [ids[idx + 1], ids[idx]] = [ids[idx], ids[idx + 1]];
          if (await reordonnerChapitres(ids)) { await charger(); }
        });
        art.querySelector('[data-ren]')?.addEventListener('click', async () => {
          const actuel = chapitres[idx]?.titre || '';
          const nouveau = await demanderTexte('Nouveau nom du chapitre', actuel);
          if (nouveau === null || !nouveau.trim() || nouveau.trim() === actuel) return;
          if (await renommerChapitre(id, nouveau)) await charger();
          else alert('Renommage impossible.');
        });
        art.querySelector('[data-del]')?.addEventListener('click', async () => {
          if (!confirm('Supprimer ce chapitre ? Les fiches liées seront conservées (sans chapitre).')) return;
          if (await supprimerChapitre(id)) await charger();
          else alert('❌ Suppression impossible.\nVérifie que tu es bien connecté, puis réessaie.');
        });
      });
    }

    async function charger() {
      chapitres = (await getChapitres(nomMatiere)).filter((c) => c.perso);
      fiches = (await getFiches()).filter((f) => f.matiere === nomMatiere);
      rendre();
    }

    document.getElementById('chapAdd')?.addEventListener('click', async () => {
      const nom = chapNom.value.trim();
      if (!nom) { chapMsg.textContent = '⚠️ Tape le nom du chapitre.'; return; }
      chapMsg.textContent = '⏳ Création…';
      const c = await creerChapitre(nomMatiere, nom);
      if (!c) { chapMsg.textContent = '❌ Création impossible. Réessaie.'; return; }
      chapNom.value = '';
      chapMsg.textContent = `✅ Chapitre « ${c.titre} » créé.`;
      await charger();
    });

    if (!isLoggedIn()) {
      liste.innerHTML = '<p class="carte-douce p-6 text-center text-sm text-slate-400">🔒 <a class="text-brand hover:underline" href="' + lien('/login') + '">Connecte-toi</a> pour voir tes chapitres.</p>';
    } else {
      charger();
    }
  </script>
</Layout>